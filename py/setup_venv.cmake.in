#
# Generated by CMake from py/setup_venv.cmake.in; run with `cmake -P`.
# Creates the build-owned venv if needed, installs the metalldata Python
# requirements into it, and puts the build-tree package on its path.
#
set(VENV_DIR "@METALLDATA_VENV_DIR@")
set(BASE_PYTHON "@Python3_EXECUTABLE@")
set(REQUIREMENTS "@METALLDATA_VENV_REQUIREMENTS@")
set(PACKAGE_DIR "@CMAKE_CURRENT_BINARY_DIR@")

if (NOT EXISTS "${VENV_DIR}/bin/python")
    message(STATUS "Creating Python virtual environment in ${VENV_DIR}")
    execute_process(COMMAND "${BASE_PYTHON}" -m venv "${VENV_DIR}"
                    COMMAND_ERROR_IS_FATAL ANY)
endif ()

set(PIP_ARGS)
foreach (req IN LISTS REQUIREMENTS)
    list(APPEND PIP_ARGS -r "${req}")
endforeach ()

# No --upgrade: on some systems the C++ build links against the pyarrow
# installed in this venv, and this step must not change it.
execute_process(COMMAND "${VENV_DIR}/bin/python" -m pip install --no-user ${PIP_ARGS}
                COMMAND_ERROR_IS_FATAL ANY)

execute_process(
    COMMAND "${VENV_DIR}/bin/python" -c "import sysconfig; print(sysconfig.get_paths()['purelib'])"
    OUTPUT_VARIABLE SITE_PACKAGES
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${SITE_PACKAGES}/metalldata.pth" "${PACKAGE_DIR}\n")
